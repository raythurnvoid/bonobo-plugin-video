{
	"name": "@bonobo/plugin-video",
	"private": true,
	"version": "0.3.5",
	"type": "module",
	"scripts": {
		"build:manifest": "node scripts/build-manifest.mjs",
		"lint": "eslint dist/**/*.js worker.test.js",
		"typecheck": "tsc --noEmit",
		"check": "pnpm run typecheck && pnpm run lint",
		"test": "vitest run",
		"test:modal": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/modal-test.ps1",
		"deploy:modal": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/modal-cli.ps1 deploy modal/media_audio_extractor.py"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20261019.1",
		"@eslint/js": "10.0.1",
		"bonobo-plugin-sdk": "github:raythurnvoid/bonobo-plugin-sdk#ea875be3eaf4c51df85233a52fad095b8625c1b5",
		"eslint": "10.13.0",
		"globals": "17.13.0",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	},
	"packageManager": "pnpm@12.14.0"
}
